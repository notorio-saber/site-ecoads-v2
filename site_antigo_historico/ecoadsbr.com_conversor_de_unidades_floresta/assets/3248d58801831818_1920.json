\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n        \r\n        body {\r\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\r\n            background: #ffffff;\r\n            min-height: 100vh;\r\n            padding: 20px;\r\n        }\r\n        \r\n        .container {\r\n            max-width: 1000px;\r\n            margin: 0 auto;\r\n            background: white;\r\n            border-radius: 20px;\r\n            box-shadow: 0 15px 40px rgba(0,0,0,0.2);\r\n            overflow: hidden;\r\n        }\r\n        \r\n        .header {\r\n            background: linear-gradient(135deg, #1B5E20, #2E7D32);\r\n            color: white;\r\n            padding: 30px;\r\n            text-align: center;\r\n        }\r\n        \r\n        .header h1 {\r\n            font-size: 28px;\r\n            margin-bottom: 10px;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            gap: 15px;\r\n        }\r\n        \r\n        .header p {\r\n            opacity: 0.9;\r\n            font-size: 16px;\r\n        }\r\n        \r\n        .content {\r\n            padding: 40px;\r\n        }\r\n        \r\n        .converter-grid {\r\n            display: grid;\r\n            grid-template-columns: 1fr 1fr;\r\n            gap: 30px;\r\n            margin-bottom: 30px;\r\n        }\r\n        \r\n        @media (max-width: 768px) {\r\n            .converter-grid {\r\n                grid-template-columns: 1fr;\r\n            }\r\n        }\r\n        \r\n        .input-section, .output-section {\r\n            background: #f8f9fa;\r\n            padding: 25px;\r\n            border-radius: 15px;\r\n            border: 2px solid #e9ecef;\r\n        }\r\n        \r\n        .section-title {\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            color: #2E7D32;\r\n            margin-bottom: 20px;\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 10px;\r\n        }\r\n        \r\n        .form-group {\r\n            margin-bottom: 20px;\r\n        }\r\n        \r\n        label {\r\n            display: block;\r\n            margin-bottom: 8px;\r\n            font-weight: 600;\r\n            color: #333;\r\n            font-size: 14px;\r\n        }\r\n        \r\n        select, input {\r\n            width: 100%;\r\n            padding: 12px;\r\n            border: 2px solid #ddd;\r\n            border-radius: 8px;\r\n            font-size: 16px;\r\n            transition: all 0.3s ease;\r\n            background: white;\r\n        }\r\n        \r\n        select:focus, input:focus {\r\n            outline: none;\r\n            border-color: #4CAF50;\r\n            box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.1);\r\n        }\r\n        \r\n        .btn {\r\n            background: linear-gradient(135deg, #4CAF50, #45a049);\r\n            color: white;\r\n            border: none;\r\n            padding: 15px 30px;\r\n            border-radius: 10px;\r\n            font-size: 16px;\r\n            font-weight: bold;\r\n            cursor: pointer;\r\n            transition: all 0.3s ease;\r\n            width: 100%;\r\n            margin: 20px 0;\r\n        }\r\n        \r\n        .btn:hover {\r\n            transform: translateY(-2px);\r\n            box-shadow: 0 8px 25px rgba(76, 175, 80, 0.3);\r\n        }\r\n        \r\n        .result-item {\r\n            background: white;\r\n            padding: 15px;\r\n            border-radius: 8px;\r\n            border-left: 4px solid #4CAF50;\r\n            margin-bottom: 15px;\r\n        }\r\n        \r\n        .result-label {\r\n            font-weight: bold;\r\n            color: #2E7D32;\r\n            font-size: 14px;\r\n            margin-bottom: 5px;\r\n        }\r\n        \r\n        .result-value {\r\n            font-family: 'Courier New', monospace;\r\n            font-size: 16px;\r\n            color: #333;\r\n            background: #f8f9fa;\r\n            padding: 8px;\r\n            border-radius: 4px;\r\n            word-break: break-all;\r\n        }\r\n        \r\n        .copy-btn {\r\n            background: #007bff;\r\n            color: white;\r\n            border: none;\r\n            padding: 8px 15px;\r\n            border-radius: 5px;\r\n            font-size: 12px;\r\n            cursor: pointer;\r\n            margin-top: 8px;\r\n            transition: all 0.3s ease;\r\n        }\r\n        \r\n        .copy-btn:hover {\r\n            background: #0056b3;\r\n        }\r\n        \r\n        .info-box {\r\n            background: #e8f5e8;\r\n            border-left: 4px solid #4CAF50;\r\n            padding: 20px;\r\n            margin: 25px 0;\r\n            border-radius: 8px;\r\n        }\r\n        \r\n        .info-box h3 {\r\n            color: #2E7D32;\r\n            margin-bottom: 10px;\r\n        }\r\n        \r\n        .info-box ul {\r\n            color: #2E7D32;\r\n            margin-left: 20px;\r\n        }\r\n        \r\n        .examples {\r\n            background: #fff3cd;\r\n            border-left: 4px solid #ffc107;\r\n            padding: 20px;\r\n            margin: 25px 0;\r\n            border-radius: 8px;\r\n        }\r\n        \r\n        .examples h3 {\r\n            color: #856404;\r\n            margin-bottom: 15px;\r\n        }\r\n        \r\n        .example-item {\r\n            margin: 10px 0;\r\n            padding: 10px;\r\n            background: rgba(255,255,255,0.7);\r\n            border-radius: 5px;\r\n            font-family: monospace;\r\n            font-size: 14px;\r\n        }\r\n        \r\n        .success-message {\r\n            background: #d4edda;\r\n            color: #155724;\r\n            padding: 10px;\r\n            border-radius: 5px;\r\n            margin: 10px 0;\r\n            display: none;\r\n            text-align: center;\r\n        }\r\n        \r\n        .error-message {\r\n            background: #f8d7da;\r\n            color: #721c24;\r\n            padding: 10px;\r\n            border-radius: 5px;\r\n            margin: 10px 0;\r\n            display: none;\r\n            text-align: center;\r\n        }\r\n\r\n        .unit-categories {\r\n            display: grid;\r\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\r\n            gap: 20px;\r\n            margin-bottom: 30px;\r\n        }\r\n\r\n        .category-card {\r\n            background: #f8f9fa;\r\n            border-radius: 10px;\r\n            padding: 20px;\r\n            border: 2px solid #e9ecef;\r\n            transition: all 0.3s ease;\r\n        }\r\n\r\n        .category-card:hover {\r\n            border-color: #4CAF50;\r\n            transform: translateY(-2px);\r\n        }\r\n\r\n        .category-title {\r\n            font-weight: bold;\r\n            color: #2E7D32;\r\n            margin-bottom: 15px;\r\n            font-size: 16px;\r\n        }\r\n\r\n        .category-card.active {\r\n            border-color: #4CAF50;\r\n            background: #e8f5e8;\r\n        }\r\n    <\/style>\r\n<\/head>\r\n<body>\r\n    <div class=\"container\">\r\n        <div class=\"header\">\r\n            <h1>\ud83c\udf32 Conversor de Unidades Florestais \ud83d\udccf<\/h1>\r\n            <p>Ferramenta desenvolvida pela ECOADS para convers\u00e3o entre unidades de medida utilizadas no setor florestal brasileiro. Converte volume de madeira, di\u00e2metro, \u00e1rea, densidade e declividade entre diferentes sistemas de medi\u00e7\u00e3o. Gera resultados precisos compat\u00edveis com normas t\u00e9cnicas e softwares de manejo florestal.<\/p>\r\n        <\/div>\r\n        \r\n        <div class=\"content\">\r\n            <div class=\"success-message\" id=\"successMessage\">\r\n                Valor copiado com sucesso! \u2705\r\n            <\/div>\r\n            \r\n            <div class=\"error-message\" id=\"errorMessage\">\r\n                Por favor, preencha o valor corretamente! \u274c\r\n            <\/div>\r\n\r\n            <div class=\"unit-categories\">\r\n                <div class=\"category-card active\" onclick=\"selectCategory('volume')\">\r\n                    <div class=\"category-title\">\ud83d\udce6 Volume de Madeira<\/div>\r\n                    <p>m\u00b3\/ha \u2194 st\/ha \u2194 ton\/ha<br>P\u00e9s board \u2194 m\u00b3<\/p>\r\n                <\/div>\r\n\r\n                <div class=\"category-card\" onclick=\"selectCategory('diametro')\">\r\n                    <div class=\"category-title\">\ud83d\udcd0 Di\u00e2metro e Forma<\/div>\r\n                    <p>DAP \u2194 Circunfer\u00eancia<br>Graus \u2194 % Declividade<\/p>\r\n                <\/div>\r\n\r\n                <div class=\"category-card\" onclick=\"selectCategory('area')\">\r\n                    <div class=\"category-title\">\ud83c\udf0d \u00c1rea e Superf\u00edcie<\/div>\r\n                    <p>Hectares \u2194 Alqueires<br>km\u00b2 \u2194 Acres<\/p>\r\n                <\/div>\r\n\r\n                <div class=\"category-card\" onclick=\"selectCategory('densidade')\">\r\n                    <div class=\"category-title\">\ud83e\udeb5 Densidade e Peso<\/div>\r\n                    <p>Densidade b\u00e1sica<br>Peso espec\u00edfico<\/p>\r\n                <\/div>\r\n            <\/div>\r\n            \r\n            <div class=\"converter-grid\">\r\n                <div class=\"input-section\">\r\n                    <div class=\"section-title\">\r\n                        \ud83d\udce5 Valor de Entrada\r\n                    <\/div>\r\n                    \r\n                    <div class=\"form-group\">\r\n                        <label for=\"inputValue\">Valor a Converter<\/label>\r\n                        <input type=\"number\" id=\"inputValue\" step=\"any\" placeholder=\"Digite o valor\" oninput=\"convertUnits()\">\r\n                    <\/div>\r\n                    \r\n                    <div class=\"form-group\">\r\n                        <label for=\"inputUnit\">Unidade de Origem<\/label>\r\n                        <select id=\"inputUnit\" onchange=\"convertUnits()\">\r\n                            <!-- Op\u00e7\u00f5es ser\u00e3o preenchidas dinamicamente -->\r\n                        <\/select>\r\n                    <\/div>\r\n                <\/div>\r\n                \r\n                <div class=\"output-section\">\r\n                    <div class=\"section-title\">\r\n                        \ud83d\udce4 Resultados da Convers\u00e3o\r\n                    <\/div>\r\n                    \r\n                    <div id=\"results\">\r\n                        <!-- Resultados ser\u00e3o preenchidos dinamicamente -->\r\n                    <\/div>\r\n                <\/div>\r\n            <\/div>\r\n            \r\n            <div class=\"info-box\">\r\n                <h3>\ud83c\udfaf Principais Convers\u00f5es na Engenharia Florestal:<\/h3>\r\n                <ul>\r\n                    <li><strong>Volume:<\/strong> 1 m\u00b3 = 1,4 st (est\u00e9reo) = 0,7 ton (aprox.)<\/li>\r\n                    <li><strong>Di\u00e2metro:<\/strong> DAP = Circunfer\u00eancia \u00f7 \u03c0 (3,14159)<\/li>\r\n                    <li><strong>Declividade:<\/strong> % = tan(graus) \u00d7 100<\/li>\r\n                    <li><strong>\u00c1rea:<\/strong> 1 hectare = 10.000 m\u00b2 = 2,47 acres<\/li>\r\n                    <li><strong>Densidade:<\/strong> Peso seco \u00f7 Volume verde<\/li>\r\n                <\/ul>\r\n            <\/div>\r\n            \r\n            <div class=\"examples\">\r\n                <h3>\ud83d\udcdd Exemplos Pr\u00e1ticos:<\/h3>\r\n                <div class=\"example-item\"><strong>Volume:<\/strong> 100 m\u00b3\/ha = 140 st\/ha = 70 ton\/ha<\/div>\r\n                <div class=\"example-item\"><strong>DAP:<\/strong> 50 cm = 157,08 cm de circunfer\u00eancia<\/div>\r\n                <div class=\"example-item\"><strong>Declividade:<\/strong> 45\u00b0 = 100% de declividade<\/div>\r\n                <div class=\"example-item\"><strong>\u00c1rea:<\/strong> 1.000 hectares = 10 km\u00b2 = 2.471 acres<\/div>\r\n            <\/div>\r\n        <\/div>\r\n    <\/div>\r\n\r\n    <script>\r\n        \/\/ Defini\u00e7\u00f5es das categorias e suas unidades\r\n        const unitCategories = {\r\n            volume: {\r\n                name: 'Volume de Madeira',\r\n                units: {\r\n                    'm3_ha': { name: 'm\u00b3\/ha', factor: 1 },\r\n                    'st_ha': { name: 'st\/ha (est\u00e9reo)', factor: 0.714 }, \/\/ 1 m\u00b3 \u2248 1.4 st\r\n                    'ton_ha': { name: 'ton\/ha', factor: 1.43 }, \/\/ 1 m\u00b3 \u2248 0.7 ton\r\n                    'm3': { name: 'm\u00b3', factor: 1 },\r\n                    'pes_board': { name: 'p\u00e9s board foot', factor: 423.776 }, \/\/ 1 m\u00b3 = 423.776 board feet\r\n                    'cord': { name: 'cord (cord\u00e3o)', factor: 0.276 } \/\/ 1 m\u00b3 \u2248 0.276 cord\r\n                }\r\n            },\r\n            diametro: {\r\n                name: 'Di\u00e2metro e Forma',\r\n                units: {\r\n                    'dap_cm': { name: 'DAP (cm)', factor: 1 },\r\n                    'circunferencia_cm': { name: 'Circunfer\u00eancia (cm)', factor: 0.318 }, \/\/ 1\/\u03c0\r\n                    'dap_polegadas': { name: 'DAP (polegadas)', factor: 2.54 },\r\n                    'graus': { name: 'Graus (\u00b0)', factor: 1 },\r\n                    'declividade_pct': { name: '% Declividade', factor: 1, special: 'slope' },\r\n                    'radianos': { name: 'Radianos', factor: 57.2958 } \/\/ 180\/\u03c0\r\n                }\r\n            },\r\n            area: {\r\n                name: '\u00c1rea e Superf\u00edcie',\r\n                units: {\r\n                    'hectares': { name: 'Hectares (ha)', factor: 1 },\r\n                    'm2': { name: 'Metros quadrados (m\u00b2)', factor: 0.0001 },\r\n                    'km2': { name: 'Quil\u00f4metros quadrados (km\u00b2)', factor: 100 },\r\n                    'acres': { name: 'Acres', factor: 2.471 },\r\n                    'alqueires_paulista': { name: 'Alqueires Paulista', factor: 4.134 },\r\n                    'alqueires_mineiro': { name: 'Alqueires Mineiro', factor: 2.066 },\r\n                    'alqueires_goiano': { name: 'Alqueires Goiano', factor: 2.066 }\r\n                }\r\n            },\r\n            densidade: {\r\n                name: 'Densidade e Peso',\r\n                units: {\r\n                    'kg_m3': { name: 'kg\/m\u00b3', factor: 1 },\r\n                    'g_cm3': { name: 'g\/cm\u00b3', factor: 1000 },\r\n                    'ton_m3': { name: 'ton\/m\u00b3', factor: 0.001 },\r\n                    'densidade_basica': { name: 'Densidade B\u00e1sica', factor: 1 },\r\n                    'peso_especifico': { name: 'Peso Espec\u00edfico', factor: 1 },\r\n                    'lb_ft3': { name: 'lb\/ft\u00b3', factor: 16.018 }\r\n                }\r\n            }\r\n        };\r\n\r\n        let currentCategory = 'volume';\r\n\r\n        function selectCategory(category) {\r\n            currentCategory = category;\r\n            \r\n            \/\/ Atualizar visual das categorias\r\n            document.querySelectorAll('.category-card').forEach(card => {\r\n                card.classList.remove('active');\r\n            });\r\n            event.target.closest('.category-card').classList.add('active');\r\n            \r\n            \/\/ Atualizar op\u00e7\u00f5es do select\r\n            updateUnitOptions();\r\n            \r\n            \/\/ Limpar resultados\r\n            document.getElementById('results').innerHTML = '';\r\n            document.getElementById('inputValue').value = '';\r\n        }\r\n\r\n        function updateUnitOptions() {\r\n            const inputUnit = document.getElementById('inputUnit');\r\n            const units = unitCategories[currentCategory].units;\r\n            \r\n            inputUnit.innerHTML = '';\r\n            \r\n            for (const [key, unit] of Object.entries(units)) {\r\n                const option = document.createElement('option');\r\n                option.value = key;\r\n                option.textContent = unit.name;\r\n                inputUnit.appendChild(option);\r\n            }\r\n        }\r\n\r\n        function convertSlope(value, fromGraus) {\r\n            if (fromGraus) {\r\n                \/\/ Graus para percentual\r\n                return Math.tan(value * Math.PI \/ 180) * 100;\r\n            } else {\r\n                \/\/ Percentual para graus\r\n                return Math.atan(value \/ 100) * 180 \/ Math.PI;\r\n            }\r\n        }\r\n\r\n        function convertUnits() {\r\n            const inputValue = parseFloat(document.getElementById('inputValue').value);\r\n            const inputUnitKey = document.getElementById('inputUnit').value;\r\n            \r\n            if (isNaN(inputValue) || !inputUnitKey) {\r\n                document.getElementById('results').innerHTML = '';\r\n                return;\r\n            }\r\n\r\n            const units = unitCategories[currentCategory].units;\r\n            const inputUnit = units[inputUnitKey];\r\n            \r\n            let resultsHTML = '';\r\n            \r\n            for (const [key, unit] of Object.entries(units)) {\r\n                if (key === inputUnitKey) continue;\r\n                \r\n                let convertedValue;\r\n                \r\n                \/\/ Convers\u00f5es especiais\r\n                if (currentCategory === 'diametro' && \r\n                    (inputUnitKey === 'graus' || inputUnitKey === 'declividade_pct' || \r\n                     key === 'graus' || key === 'declividade_pct')) {\r\n                    \r\n                    if (inputUnitKey === 'graus' && key === 'declividade_pct') {\r\n                        convertedValue = convertSlope(inputValue, true);\r\n                    } else if (inputUnitKey === 'declividade_pct' && key === 'graus') {\r\n                        convertedValue = convertSlope(inputValue, false);\r\n                    } else {\r\n                        \/\/ Convers\u00e3o normal para outras unidades de di\u00e2metro\r\n                        convertedValue = inputValue * inputUnit.factor \/ unit.factor;\r\n                    }\r\n                } else {\r\n                    \/\/ Convers\u00e3o normal\r\n                    convertedValue = inputValue * inputUnit.factor \/ unit.factor;\r\n                }\r\n                \r\n                resultsHTML += `\r\n                    <div class=\"result-item\">\r\n                        <div class=\"result-label\">${unit.name}<\/div>\r\n                        <div class=\"result-value\" id=\"result-${key}\">${convertedValue.toFixed(6)}<\/div>\r\n                        <button class=\"copy-btn\" onclick=\"copyToClipboard('result-${key}')\">Copiar<\/button>\r\n                    <\/div>\r\n                `;\r\n            }\r\n            \r\n            document.getElementById('results').innerHTML = resultsHTML;\r\n        }\r\n        \r\n        function copyToClipboard(elementId) {\r\n            const element = document.getElementById(elementId);\r\n            const text = element.textContent;\r\n            \r\n            navigator.clipboard.writeText(text).then(function() {\r\n                const successMessage = document.getElementById('successMessage');\r\n                successMessage.style.display = 'block';\r\n                setTimeout(() => {\r\n                    successMessage.style.display = 'none';\r\n                }, 2000);\r\n            }).catch(function(err) {\r\n                console.error('Erro ao copiar: ', err);\r\n            });\r\n        }\r\n        \r\n        \/\/ Inicializar\r\n        updateUnitOptions();\r\n    <\/script>\r\n<\/body>\r\n<\/html>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-4fed531 elementor-hidden-tablet elementor-hidden-mobile e-flex e-con-boxed e-con e-parent\" data-id=\"4fed531\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-ca1ceee e-grid e-con-full e-con e-child\" data-id=\"ca1ceee\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-ade3905 e-con-full e-flex e-con e-child\" data-id=\"ade3905\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-d5e0396 elementor-widget elementor-widget-heading\" data-id=\"d5e0396\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">EcoAds - Ag\u00eancia Digital Ambiental\n<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-ca57c96 elementor-widget elementor-widget-text-editor\" data-id=\"ca57c96\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\tA \u00fanica ag\u00eancia especializada em marketing digital para profissionais e empresas do setor ambiental e florestal.\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-775d94d elementor-widget elementor-widget-image\" data-id=\"775d94d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img fetchpriority=\"high\" decoding=\"async\" width=\"600\" height=\"120\" src=\"https:\/\/ecoadsbr.com\/wp-content\/uploads\/2025\/02\/sdfsfsdf.png\" class=\"attachment-large size-large wp-image-